{
  "name": "node-sonar-ci",
  "version": "1.0.0",
  "description": "Sample Node.js app for Jenkins CI with SonarQube code analysis",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/**/*.js", "!src/server.js"],
    "coverageReporters": ["lcov", "text"],
    "coverageDirectory": "coverage"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
